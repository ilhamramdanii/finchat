# ========================
# APP
# ========================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ========================
# WHATSAPP
# ========================
WA_SESSION_PATH=./wa-sessions
WA_OWNER_PHONE=628xxxxxxxxxx

# ========================
# OTP (Sprint 1)
# ========================
OTP_TTL_SEC=300
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SEC=900